{
  "name": "hathor-qa-helper",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @qa-helper/client dev",
    "dev:bg": "bun --filter @qa-helper/client dev:bg",
    "dev:kill": "bun --filter @qa-helper/client dev:kill",
    "dev:restart": "bun --filter @qa-helper/client dev:restart",
    "dev:server": "bun --filter @qa-helper/server dev",
    "dev:all": "bun --filter '@qa-helper/{client,server}' dev",
    "build": "bun --filter @qa-helper/client build",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "bun --filter @qa-helper/client lint",
    "lint:fix": "bun --filter @qa-helper/client lint:fix",
    "format": "prettier --write \"{apps,packages}/*/{src,tests}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"{apps,packages}/*/{src,tests}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "bun --filter '*' test",
    "test:e2e": "bun --filter @qa-helper/client test:e2e",
    "deploy": "bun --filter @qa-helper/client deploy",
    "upload": "bun --filter @qa-helper/client upload",
    "helper:up": "scripts/qa-helper.sh up",
    "helper:down": "scripts/qa-helper.sh down",
    "helper:status": "scripts/qa-helper.sh status"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.8.3"
  },
  "resolutions": {
    "vite": "npm:rolldown-vite@7.1.14"
  }
}
