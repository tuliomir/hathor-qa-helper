{
  "name": "@qa-helper/client",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:bg": "vite &",
    "dev:kill": "lsof -ti:5173 -ti:5174 | xargs kill 2>/dev/null || true",
    "dev:clean": "rm -rf node_modules/.vite",
    "dev:restart": "bun run dev:kill && bun run dev:clean && bun run dev:bg && sleep 3",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "preview": "vite preview",
    "test": "bun test tests/",
    "test:watch": "bun test --watch tests/",
    "test:e2e": "bunx playwright test --project=dev",
    "test:e2e:preview": "SMOKE_ENV=preview bunx playwright test --project=preview",
    "test:e2e:headed": "bunx playwright test --project=dev --headed",
    "test:e2e:debug": "bunx playwright test --project=dev --debug",
    "test:e2e:report": "bunx playwright show-report",
    "build:binary": "bun build --compile standalone.ts --outfile qa-helper-standalone",
    "upload": "bun run build && ./scripts/deploy.sh",
    "upload:cloudflare": "bun run build && ./scripts/deploy.sh",
    "upload:firebase": "bun run build && ./scripts/deploy-firebase.sh",
    "deploy": "./scripts/deploy.sh",
    "deploy:firebase": "./scripts/deploy-firebase.sh"
  },
  "dependencies": {
    "@hathor/snap-utils": "^0.1.0",
    "@hathor/wallet-lib": "^3.1.1",
    "@qa-helper/shared": "workspace:*",
    "@reduxjs/toolkit": "^2.12.0",
    "@walletconnect/core": "^2.23.9",
    "@walletconnect/modal": "^2.7.0",
    "@walletconnect/sign-client": "^2.23.9",
    "@walletconnect/types": "^2.23.9",
    "@walletconnect/utils": "^2.23.9",
    "@zxing/browser": "^0.1.5",
    "bitcore-lib": "8.25.10",
    "bitcore-mnemonic": "8.25.10",
    "buffer": "^6.0.3",
    "date-fns": "^4.3.0",
    "idb": "^8.0.3",
    "react": "^19.2.6",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-qr-code": "^2.0.21",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.15.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "daisyui": "^5.5.20",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.60.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "vite-plugin-node-polyfills": "^0.24.0"
  }
}
